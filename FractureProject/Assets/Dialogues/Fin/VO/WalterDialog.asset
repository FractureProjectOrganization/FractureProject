  <dialog>k__BackingField:
  - text: Mom...
    isPlayer: 0
    actorName: Walter
  - text: Mom, I'm so sorry.
    isPlayer: 0
    actorName: Walter
  - text: I messed up.
    isPlayer: 0
    actorName: Walter
  - text: You never got past the wall, right?
    isPlayer: 1
    actorName: Ursula
  - text: The guards are going to take me away.
    isPlayer: 0
    actorName: Walter
  - text: I'm scared mom.
    isPlayer: 0
    actorName: Walter
  - text: I'm scared of dying.
    isPlayer: 0
    actorName: Walter
  - text: Don't be scared, mommy's here darling.
    isPlayer: 1
    actorName: Ursula
  - text: I'm coming to get you.
    isPlayer: 1
    actorName: Ursula
  - text: Mom, I'll forever live in Ost-Berlin.
    isPlayer: 0
    actorName: Walter
  - text: Please, don't come looking for me.
    isPlayer: 0
    actorName: Walter
  - text: Live on without me.
    isPlayer: 0
    actorName: Walter
  - text: Live on for me.
    isPlayer: 0
    actorName: Walter
  - text: You've been really brave sweetie.
    isPlayer: 1
    actorName: Ursula
  - text: I'm so proud of you Walter.
    isPlayer: 1
    actorName: Ursula
