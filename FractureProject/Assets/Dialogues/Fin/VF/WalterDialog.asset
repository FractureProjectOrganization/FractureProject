  m_Name: WalterDialog
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  <dialog>k__BackingField:
  - text: Maman...
    isPlayer: 0
    actorName: Walter
  - text: "Tu n'as jamais r\xE9ussi \xE0 traverser, n'est-ce pas ?"
    isPlayer: 1
    actorName: Ursula
  - text: "Maman, je suis vraiment d\xE9sol\xE9."
    isPlayer: 0
    actorName: Walter
  - text: "J'ai tout rat\xE9."
    isPlayer: 0
    actorName: Walter
  - text: Je sais.
    isPlayer: 1
    actorName: Ursula
  - text: Les gardes vont m'emmener.
    isPlayer: 0
    actorName: Walter
  - text: J'ai peur maman...
    isPlayer: 0
    actorName: Walter
  - text: J'ai peur de mourir...
    isPlayer: 0
    actorName: Walter
  - text: "N'aies pas peur... Maman est l\xE0, mon ch\xE9ri."
    isPlayer: 1
    actorName: Ursula
  - text: Je viens te chercher
    isPlayer: 1
    actorName: Ursula
  - text: "Maman... je vivrai \xE0 l'Est pour toujours."
    isPlayer: 0
    actorName: Walter
  - text: "S'il te pla\xEEt... ne viens pas me chercher."
    isPlayer: 0
    actorName: Walter
  - text: Vis sans moi.
    isPlayer: 0
    actorName: Walter
  - text: Vis ta vie pour moi.
    isPlayer: 0
    actorName: Walter
  - text: "Tu as \xE9t\xE9 tr\xE8s courageux, mon ch\xE9ri."
    isPlayer: 1
    actorName: Ursula
  - text: "Je suis si fi\xE8re de toi, Walter."
    isPlayer: 1
    actorName: Ursula
