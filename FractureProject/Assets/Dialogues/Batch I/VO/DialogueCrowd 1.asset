  <dialog>k__BackingField:
  - text: Why did they stop moving?
    isPlayer: 1
    actorName: Ursula
  - text: These damned guards are stopping us from getting to the wall!
    isPlayer: 1
    actorName: Ursula
  - text: If they saw a crowd coming towards them, they'd lets us go.
    isPlayer: 1
    actorName: Ursula
  - text: There are a lot of us after all.
    isPlayer: 1
    actorName: Ursula
